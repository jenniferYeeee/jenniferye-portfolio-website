---
import Media from './Media.astro';
import type { ProjectEntry } from '../lib/projects';
import { withBase } from '../lib/format';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data, id } = project;
---

<article class="tile" data-project={id}>
  <a class="link" href={withBase(`/work/${id}/`)}>
    <Media media={data.video} kind="video" variant="tile" transitionName={`media-${id}`} />
    <div class="text">
      <h3 transition:name={`title-${id}`}>{data.title}</h3>
      <p class="summary">{data.summary}</p>
      <p class="meta">{data.org}</p>
    </div>
  </a>
</article>

<script>
  /**
   * Tile previews are muted loops that play only while the pointer is over the tile (or its
   * link has keyboard focus) and stop when it leaves. With reduced motion, nothing plays.
   */
  function setup() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const controller = new AbortController();
    const { signal } = controller;
    for (const tile of document.querySelectorAll<HTMLElement>('article.tile')) {
      const video = tile.querySelector<HTMLVideoElement>('video[data-hover-play]');
      if (!video || tile.dataset.hoverReady) continue;
      tile.dataset.hoverReady = 'true';
      const play = () => void video.play().catch(() => {});
      const stop = () => video.pause();
      tile.addEventListener('pointerenter', play, { signal });
      tile.addEventListener('pointerleave', stop, { signal });
      tile.addEventListener('focusin', play, { signal });
      tile.addEventListener('focusout', stop, { signal });
    }
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .link {
    display: grid;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .link:hover {
    color: inherit;
  }

  .link :global(.media) {
    transition: transform 0.6s var(--ease);
  }

  .link:hover :global(.media) {
    transform: scale(0.988);
  }

  .text {
    display: grid;
    gap: 0.4rem;
    max-width: var(--measure);
  }

  h3 {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .link :global(.media--tile) {
    aspect-ratio: 4 / 3;
  }

  .link:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .summary {
    color: var(--muted);
  }

  .meta {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
