---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { render } from 'astro:content';
import { getProjects, nextProject, type ProjectEntry } from '../../lib/projects';
import { formatPeriod, withBase } from '../../lib/format';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((project) => ({
    params: { slug: project.id },
    props: { project, next: nextProject(all, project.id) },
  }));
}

interface Props {
  project: ProjectEntry;
  next: ProjectEntry;
}

const { project, next } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);
---

<Base title={data.title} description={data.summary}>
  <article class="project" data-project={id}>
    <header class="wrap head">
      <a class="back" href={withBase('/#work')}>
        All work
      </a>
      <h1 transition:name={`title-${id}`}>{data.title}</h1>
      <p class="summary">{data.summary}</p>
    </header>

    <div class="wrap">
      <Media media={data.video} kind="video" variant="page" transitionName={`media-${id}`} />
    </div>

    <div class="wrap body">
      <dl class="facts">
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>{data.org}</dd>
        </div>
        <div>
          <dt>When</dt>
          <dd>{formatPeriod(data.start, data.end)}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{data.stack.join(', ')}</dd>
        </div>
      </dl>

      <div class="prose">
        <h2>Overview</h2>
        <Content />

        <h2>Outcomes</h2>
        <ul class="highlights">
          {data.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
    </div>

    {data.extras.map((x, i) => (
      <section class="wrap extra" aria-labelledby={`extra-${i}-title`} data-extra>
        <h2 id={`extra-${i}-title`}>{x.title}</h2>
        <figure>
          <video
            controls
            playsinline
            preload="metadata"
            poster={x.poster ? withBase(x.poster) : undefined}
            aria-label={x.alt}
          >
            <source src={withBase(x.src)} type="video/mp4" />
          </video>
          <figcaption>{x.caption}</figcaption>
        </figure>
      </section>
    ))}

    <section class="wrap diagram" aria-labelledby="diagram-title">
      <h2 id="diagram-title">System design</h2>
      <Media media={data.diagram} kind="diagram" variant="page" transitionName={`diagram-${id}`} />
    </section>

    {data.report && (
      <section class="wrap report" aria-labelledby="report-title" data-report>
        <div class="report-head">
          <h2 id="report-title">Final report</h2>
          <a href={withBase(data.report.src)} target="_blank" rel="noopener">
            Open in a new tab
          </a>
        </div>
        <iframe src={withBase(data.report.src)} title={data.report.title} loading="lazy"></iframe>
      </section>
    )}

    <nav class="wrap next" aria-label="Next project">
      <a href={withBase(`/work/${next.id}/`)} data-next>
        <span class="next-label">Next project</span>
        <span class="next-title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<script>
  /** The main demo loops muted (controls stay, so it can be paused). Reduced motion: no autoplay. */
  function autoplayDemo() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-page-autoplay]')) {
      v.muted = true;
      void v.play().catch(() => {});
    }
  }
  document.addEventListener('astro:page-load', autoplayDemo);
</script>

<style>
  .head {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.25rem;
  }

  .back {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }

  .back::before {
    content: '‹ ';
  }

  h1 {
    font-size: clamp(2.25rem, 1.2rem + 5.2vw, 5.75rem);
    letter-spacing: -0.04em;
    max-width: 14em;
  }

  .summary {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--measure);
  }

  .body {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 900px) {
    .body {
      grid-template-columns: 1fr 2fr;
      gap: 5rem;
    }
  }

  .facts {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .prose {
    max-width: var(--measure);
  }

  .prose h2,
  .extra h2,
  .report h2,
  .diagram h2 {
    font-size: var(--step-1);
    margin-bottom: 1rem;
  }

  .prose h2:not(:first-child) {
    margin-top: 3rem;
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .highlights {
    padding-left: 1.1em;
    display: grid;
    gap: 0.75rem;
  }

  .highlights li::marker {
    color: var(--muted);
  }

  .diagram,
  .extra,
  .report {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .extra figure {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .extra video {
    display: block;
    width: 100%;
    max-height: 80vh;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--panel);
    border-radius: var(--radius-lg);
  }

  .extra figcaption {
    color: var(--muted);
    max-width: var(--measure);
  }

  .report-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }

  .report-head h2 {
    margin-bottom: 0;
  }

  .report-head a {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .report iframe {
    display: block;
    width: 100%;
    height: min(85vh, 60rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .next {
    border-top: 1px solid var(--rule);
  }

  .next a {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(3rem, 7vw, 5rem);
    text-decoration: none;
  }

  .next-label {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .next-title {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .next a:hover .next-title {
    color: var(--signal);
  }
</style>
